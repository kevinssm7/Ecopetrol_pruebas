@model AsaludEcopetrol.Models.InventarioAltoCosto.GestionAltoCostoViewModel

<div class="panel-body">

    @if (Model.Tipo == 1 && Model.Cancer != null)
    {
        <form id="GuardarGestionCancer" action="GuardarGestionCancer" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" id="tipo" name="tipo" value="@ViewBag.tipo" />
            <input type="hidden" id="id_cancer" name="Cancer.id_cancer" value="@ViewBag.id" />

            <div id="tipoCancer">
                <div class="row">
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Mes Rastreo:</label>
                        <input type="text" id="Cancer_rastreo_mes" name="Cancer.rastreo_mes" class="form-control" readonly value="@Model.Cancer.rastreo_mes" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Año rastreo:</label>
                        <input type="text" id="Cancer_año_rastreo" name="Cancer.año_rastreo" class="form-control" readonly value="@Model.Cancer.año_rastreo" />
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">

                        <label class="text-secondary_asalud">Regional:</label>

                        <select id="Cancer_regional" name="Cancer.regional" class="form-control select2" onchange="CargarUnis(this)" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.Ref_regional item in ViewBag.regional)
                            {
                                var selected = item.indice == Model.Cancer.regional ? "selected" : "";
                                <option value="@item.indice" data-id="@item.id_ref_regional" @selected>@item.nombre_regional</option>
                            }
                        </select>


                    </div>

                    <div class="col-sm-6">
                        <label class="text-secondary_asalud">Unis</label>
                        <select class="form-control select2" id="cbxunis" name="Cancer.unis" required>
                            <option value="">- Seleccionar -</option>

                            @{
                                var listaUnis = ViewBag.unis as List<ECOPETROL_COMMON.ENTIDADES.Ref_odont_unis>;
                                if (!string.IsNullOrEmpty(Model.Cancer.unis) && listaUnis != null)
                                {
                                    var unisSeleccionada = listaUnis.FirstOrDefault(u => u.descripcion == Model.Cancer.unis);
                                    if (unisSeleccionada != null)
                                    {
                                        <text>
                                            <option value="@unisSeleccionada.descripcion" selected>@unisSeleccionada.descripcion</option>
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            <option value="@Model.Cancer.unis" selected>@Model.Cancer.unis</option>
                                        </text>
                                    }
                                }

                            }
                        </select>
                    </div>

                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Tipo de Documento:</label>
                        <input type="text" id="Cancer_tipo_documento" name="Cancer.tipo_documento" class="form-control" readonly value="@Model.Cancer.tipo_documento" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Documento Paciente:</label>
                        <input type="text" id="Cancer_documento_paciente" name="Cancer.documento_paciente" class="form-control" value="@(Model.Cancer.documento_paciente != null ? Model.Cancer.documento_paciente : Model.Cancer.documento)" required />
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Nombres:</label>
                        <input type="text" id="Cancer_nombres" name="Cancer.nombres" class="form-control" readonly value="@Model.Cancer.primer_nombre @Model.Cancer.segundo_nombre" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Apellidos:</label>
                        <input type="text" id="Cancer_apellidos" name="Cancer.apellidos" class="form-control" readonly value="@Model.Cancer.primer_apellido @Model.Cancer.segundo_apellido" />
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Fecha de Nacimiento:</label>
                        <input type="text" id="fecha_nacimiento" name="Cancer.fecha_nacimiento" class="form-control" style="width:100%;" readonly value="@Model.Cancer.fecha_nacimiento" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Edad:</label>
                        <input type="text" id="Cancer_edad" name="Cancer.edad" class="form-control" readonly value="@Model.Cancer.edad" />
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Sexo:</label>
                        <input type="text" id="Cancer_sexo" name="Cancer.sexo" class="form-control" readonly value="@Model.Cancer.sexo" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Diagnóstico CIE10:</label>
                        <input type="text" id="cie10" name="Cancer.diagnostico_cie10" class="form-control" value="@Model.Cancer.diagnostico_cie10" required />
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Descripción CIE10:</label>
                        <input type="text" id="descripcion_dx" name="Cancer.descripcion_dx" class="form-control" value="@Model.Cancer.descripcion_dx" required />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Agrupador:</label>
                        <select id="Cancer_agrupador" name="Cancer.agrupador" class="form-control select3" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_agrupador item in ViewBag.agrupador)
                            {
                                var selected = item.descripcion_agrupador == Model.Cancer.agrupador ? "selected" : "";
                                <option value="@item.descripcion_agrupador" @selected>@item.descripcion_agrupador</option>
                            }

                        </select>
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Detección Temprana:</label>
                        <input type="text" id="Cancer_deteccion_temprana" name="Cancer.deteccion_temprana" class="form-control" readonly value="@Model.Cancer.deteccion_temprana" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Cuenta Alto Costo:</label>
                        <input type="text" id="Cancer_cuenta_altocosto" name="Cancer.cuenta_altocosto" class="form-control" readonly value="@Model.Cancer.cuenta_altocosto" />
                    </div>
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Quimioterapia/Radioterapia:</label>
                        <input type="text" id="Cancer_quimioterapia_radioterapia" name="Cancer.quimioterapia_radioterapia" class="form-control" readonly value="@Model.Cancer.quimioterapia_radioterapia" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Fecha de corte:</label>
                        <input type="text" id="fecha_corte" name="Cancer.fecha_corte" class="form-control" style="width:100%;" readonly value="@Model.Cancer.fecha_corte" />
                    </div>
                </div>

         
                <br />


                <div class="row">
                    <div class="col-md-12 text-center">
                        <button type="button" onclick="ValidarFormulario()" class="btn button_Asalud_Guardar">Guardar</button>

                    </div>
                </div>

                <br />
            </div>

        </form>

    }



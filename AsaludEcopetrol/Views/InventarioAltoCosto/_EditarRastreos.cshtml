<script>

    let initialFormData = {};
    let initialFormData2 = {};
    let initialFormData3 = {};
    let initialFormData4 = {};

    function MostrarCie10() {

        $("#cie10").autocomplete({
            source: function (request, response) {

                if (request.term.length > 0) {
                    $.ajax({
                        url: "/InventarioAltoCosto/BuscarCie10",
                        type: "POST",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            if (data.length > 0 && data != null) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.label,
                                        value: item.id
                                    };
                                }));
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error(xhr.responseText);
                        }
                    });
                }
            },
            select: function (event, ui) {

                var detalle = ui.item.label;
                var descomposicion = detalle.split('-');
                var descripcion = descomposicion[1];
                $("#descripcion_dx").val(descripcion);
            }
        });


        $("#descripcion_dx").autocomplete({
            source: function (request, response) {
                if (request.term.length > 0) {
                    $.ajax({
                        url: "/InventarioAltoCosto/BuscarCie10",
                        type: "POST",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            if (data.length > 0 && data != null) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.label,
                                        value: item.des
                                    };
                                }));
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error(xhr.responseText);
                        }
                    });
                }
            },
            select: function (event, ui) {



                var detalle = ui.item.label;
                var descomposicion = detalle.split('-');
                var descripcion = descomposicion[0];
                $("#cie10").val(descripcion);
            }
        });

    }


    $(document).ready(function () {


        $("#fecha_nacimiento").kendoDatePicker();
        $("#fecha_corte").kendoDatePicker();

        $(".k-input").attr('readonly', true);

        MostrarCie10();


        // Captura formulario Cáncer
        const form1 = document.getElementById('GuardarGestionCancer');
        if (form1) {
            form1.querySelectorAll("input, select, textarea").forEach(el => {
                if (el.name) initialFormData[el.name] = el.value;
            });
        }

        // Captura formulario Hemofilia
        const form2 = document.getElementById('GuardarGestionHemofilia');
        if (form2) {
            form2.querySelectorAll("input, select, textarea").forEach(el => {
                if (el.name) initialFormData2[el.name] = el.value;
            });
        }

        // Captura formulario Artritis
        const form3 = document.getElementById('GuardarGestionArtritis');
        if (form3) {
            form3.querySelectorAll("input, select, textarea").forEach(el => {
                if (el.name) initialFormData3[el.name] = el.value;
            });
        }

        // Captura formulario VIH
        const form4 = document.getElementById('GuardarGestionVIH');
        if (form4) {
            form4.querySelectorAll("input, select, textarea").forEach(el => {
                if (el.name) initialFormData4[el.name] = el.value;
            });
        }


    });


    function CargarUnis(selectElement) {
        var selectedOption = selectElement.options[selectElement.selectedIndex];
        var idRefRegional = selectedOption.getAttribute("data-id");

        if (idRefRegional && idRefRegional !== "") {
            $("#cbxunis").empty();

            $.ajax({
                url: "@Url.Action("ObtenerUnis")",
                type: "POST",
                data: { idregional: idRefRegional },
                success: function (data) {
                    $("#cbxunis").empty();
                    $("#cbxunis").html(data);
                    $("#cbxunis").val("").trigger("change");
                },
                error: function () {
                    alert("Error al cargar las unis de la regional.");
                }
            });
        }
    }



    function ValidarFormulario() {
        var validator = $("#GuardarGestionCancer").validate();
        if (validator.form()) {
            // Comprobar si algún campo cambió
            let isModified = false;
            $("#GuardarGestionCancer").find("input, select, textarea").each(function () {
                if (this.name && initialFormData[this.name] !== $(this).val()) {
                    isModified = true;
                }
            });

            if (isModified) {
                LoadingShow();
                $("#GuardarGestionCancer").submit();
            } else {
                alert("No se han realizado cambios en el formulario.");
            }
        }
    }




    function ValidarFormulario2() {
        var validator = $("#GuardarGestionHemofilia").validate();
        if (validator.form()) {
            // Comprobar si algún campo cambió
            let isModified = false;

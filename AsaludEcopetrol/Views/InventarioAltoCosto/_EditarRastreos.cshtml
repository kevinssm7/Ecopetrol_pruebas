                $("#GuardarGestionHemofilia").submit();
            } else {
                alert("No se han realizado cambios en el formulario.");
            }
        }
    }


    function ValidarFormulario3() {
        var validator = $("#GuardarGestionArtritis").validate();
        if (validator.form()) {
            // Comprobar si algún campo cambió
            let isModified = false;
            $("#GuardarGestionArtritis").find("input, select, textarea").each(function () {
                if (this.name && initialFormData3[this.name] !== $(this).val()) {
                    isModified = true;

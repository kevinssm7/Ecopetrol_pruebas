
@{
    ViewBag.Title = "TABLERO RECOMENDACIONES";
    Layout = "~/Views/Shared/_LayoutECOPETROL.cshtml";
}

<div class="container">

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong class="text-primary_asalud">Listado de recomendaciones</strong>
        </div>

        <div class="panel-body">
            <table id="tabla" class="table table-striped table-bordered table-condensed datatable table-responsive">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Tipo filtrado</th>
                        <th>Tipo codificación</th>
                        <th>CUPS</th>
                        <th>Diagnóstico</th>
                        <th>Tipo edad</th>
                        <th>Edad</th>
                        <th>Tipo género</th>
                        <th>Tipo recomendación</th>
                        <th>Justificación</th>
                        <th>Estado</th>
                        <th>Usuario digita</th>
                        <th>Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.conteo > 0)
                    {
                        foreach (ECOPETROL_COMMON.ENTIDADES.management_recomendacion_tableroControlResult item in ViewBag.listado)
                        {
                            <tr>
                                <td>@item.id_recomendacion</td>
                                <td>@item.descripcionTipoFiltrado</td>
                                <td>@item.descripcionTipoCodificacion</td>
                                <td>@item.cups</td>
                                <td>@item.diagnostico</td>
                                <td>@item.tipo_edad</td>
                                <td>@item.edad</td>
                                <td>@item.tipo_genero</td>
                                <td>@item.descripcionTipoRecomendacion</td>
                                <td>@item.observaciones</td>
                                <td>@item.descripcionEstado</td>
                                <td>@item.nombreDigita</td>
                                <td>
                                    <a class="button_Asalud_Guardar" onclick="EditarRecomendacion(@item.id_recomendacion)">Editar</a>
                                    <a class="button_Asalud_Rechazar" onclick="EliminarRecomendacion(@item.id_recomendacion)">Eliminar</a>
                                    <a class="button_Asalud_Aceptar" onclick="CambioEstado(@item.id_recomendacion, @item.estado)">Estado</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" style="width:100%;">SIN DATOS</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>

    $('#tabla').DataTable({
        "searching": true,
        "aLengthMenu": [[50, 100, 250, 500, 1000, 5000, -1], [50, 100, 250, 500, 1000, 5000, "Todos"]],
        "iDisplayLength": -1,
        "lengthchange": true,
        "info": false,
        "responsive": true,
        "zeroRecords": "No se encontraron resultados",
        responsive: true,
        language: {
            sLengthMenu: "Ver _MENU_ registros",
            processing: "Procesando...",
            search: "Buscar:",
            lengthmenu: "Mostrar menu registros",
            info: "Mostrando registros del start al end de un total de total registros",
            infoempty: "Mostrando registros del 0 al 0 de un total de 0 registros",
            infofiltered: "(Filtrado de un total de max registros)",
            loadingrecords: "Cargando...",
            zerorecords: "No se encontraron resultados",
            emptytable: "Ningún dato disponible en esta tabla",
            paginate: {
                first: "Primero",
                previous: "Anterior",
                next: "Siguiente",
                last: "Ultimo",
            },
        }
    });

    function EditarRecomendacion(id) {

        var confirmar = confirm("¿Seguro(a) de editar esta recomendación");
        if (confirmar) {
            location.href = "@Url.Action("CreacionecomendacionesAuditoria", "FIS_RIPS")?idRecomendacion=" + id;
        }
    }

    function EliminarRecomendacion(id) {
        var confirmar = confirm("¿Seguro(a) de eliminar esta recomendación");
        if (confirmar) {
            LoadingShow();
            $.ajax({
                url: "@Url.Action("EliminarRecomendacion")",
                type: "post",
                data: {
                    idRecomendacion: id
                },
                method: 'POST',
                success: function (data) {

                    alert(data.mensaje);
                    LoadingHide();

                    if (data.rta == 1) {
                        location.reload();
                    }
                }
            });
        }
    }

    function CambioEstado(id, estado) {
         var confirmar = confirm("¿Seguro(a) de cambiar el estado de esta recomendación");
        if (confirmar) {
            LoadingShow();
            $.ajax({
                url: "@Url.Action("EditarEstadoRecomendacion")",
                type: "post",
                data: {
                    idRecomendacion: id,
                    estado: estado,
                },
                method: 'POST',
                success: function (data) {

                    alert(data.mensaje);
                    LoadingHide();

                    if (data.rta == 1) {
                        location.reload();
                    }
                }
            });
        }
    }
</script>



@model ECOPETROL_COMMON.ENTIDADES.creacion_recomendaciones_auditoria

@{
    ViewBag.Title = "CREACIÓN RECOMENDACIONES AUDITORIA";
    Layout = "~/Views/Shared/_LayoutECOPETROL.cshtml";
}

<div class="container">
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong class="text-primary_asalud">DATOS BÁSICOS</strong>
        </div>
        <div class="panel-body">
            <form id="formReco">
                <div class="panel-body">
                    <div class="row">
                        
                        <input type="hidden" id="idRecomendacion" name="idRecomendacion" value="@Model.id_recomendacion" />
                        <div class="col-md-3">
                            <label class="text-secondary_asalud">Tipo filtrado</label>
                            <select id="tipoFiltrado" name="tipoFiltrado" class="form-control" onchange="CambioTipoFiltrado(this.value)" required>
                                <option value="">-Seleccione-</option>
                                @foreach (ECOPETROL_COMMON.ENTIDADES.ref_recomendaciones_tipoFiltrado item in ViewBag.tipoFiltrado)
                                {
                                    <option value="@item.id_tipo">@item.descripcion</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="text-secondary_asalud">Tipo codificación</label>
                            <select id="tipoCodificacion" name="tipoCodificacion" class="form-control" onchange="CambioTipoCodificacion(this.value)" required>
                                <option value="">-Seleccione-</option>
                                @foreach (ECOPETROL_COMMON.ENTIDADES.ref_recomendaciones_tipoCodificacion item in ViewBag.tipoCodificacion)
                                {
                                    <option value="@item.id_tipo">@item.descripcion</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="text-secondary_asalud">Tipo recomendación</label>
                            <select id="tipoRecomendacion" name="tipoRecomendacion" class="form-control select2" required>
                                <option value="">-Seleccione-</option>
                                @foreach (ECOPETROL_COMMON.ENTIDADES.ref_recomendaciones_tipoRecomendacion item in ViewBag.tipoRecomendacion)
                                {
                                    <option value="@item.id_tipo">@item.descripcion</option>
                                }
                            </select>
                        </div>
                    </div>
                    <br />

                    <div class="row divEnglobado">

                        <div id="divEdad" style="display:none;" class="col-md-6">
                            <div class="col-md-6">
                                <label class="text-secondary_asalud">Tipo edad</label>
                                <select id="tipoEdad" name="tipoEdad" class="form-control" required>
                                    <option value="">-Seleccione-</option>
                                    <option value="<">Menor</option>
                                    <option value=">">Mayor</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="text-secondary_asalud">Edad</label>
                                <input type="text" class="form-control solo-mumero" id="edad" name="edad" maxlength="3" required />
                            </div>
                        </div>

                        <div id="divGenero" style="display:none;" class="col-md-3">
                            <div class="col-md-12">
                                <label class="text-secondary_asalud">Tipo género</label>
                                <select id="tipoGenero" name="tipoGenero" class="form-control" required>
                                    <option value="">-Seleccione-</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Femenino">Femenino</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                        </div>

                        <div id="divEdad" style="display:none;" class="col-md-6">
                            <div class="col-md-6">
                                <label class="text-secondary_asalud">Tipo edad</label>
                                <select id="tipoEdad" name="tipoEdad" class="form-control" required>
                                    <option value="">-Seleccione-</option>
                                    <option value="<">Menor</option>
                                    <option value=">">Mayor</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="text-secondary_asalud">Edad</label>
                                <input type="text" class="form-control solo-mumero" id="edad" name="edad" maxlength="3" required />
                            </div>
                        </div>

                        <div id="divCUPS" style="display:none;" class="col-md-3">
                            <div class="col-md-12">
                                <label class="text-secondary_asalud">CUPS</label>
                                <input type="text" class="form-control" id="cups" name="cups" maxlength="50" required />
                            </div>
                        </div>

                        <div id="divDiagnostico" style="display:none;" class="col-md-3">
                            <div class="col-md-12">
                                <label class="text-secondary_asalud">Diagnóstico</label>
                                <input type="text" class="form-control" id="diagnostico" name="diagnostico" maxlength="50" required />
                            </div>
                        </div>
                    </div>

                    <br />

                    <div class="row">
                        <div class="col-md-12">
                            <label class="text-secondary_asalud">Justificación</label>
                            <textarea id="observaciones" name="observaciones" class="form-control" cols="4" rows="4" maxlength="4999" required></textarea>
                        </div>
                    </div>

                    <br />
                    <div class="row">
                        <div class="col-md-12 text-center">
                            <a class="button_Asalud_Guardar" onclick="GuardarRecomendacion();">GUARDAR</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/Scripts/validate.js"></script>

<script>

    $(document).ready(function () {

        $('.select2').select2({
            width: '100%',
            height: '100%'
        });

        $('.solo-numero').keyup(function () {
            this.value = (this.value + '').replace(/[^0-9]/g, '');
        });

        $(".k-input").attr('readonly', true);

        var idRecomendacion = "@Model.id_recomendacion";
        if (idRecomendacion != "0" && idRecomendacion != "" && idRecomendacion != null) {
            PintarDatos();
        }
    });

    function PintarDatos() {
  
        $("#tipoFiltrado").val("@Model.tipo_filtrado").trigger("change");
        $("#tipoCodificacion").val("@Model.tipo_codificacion").trigger("change");
        $("#cups").val("@Model.cups").trigger("change");
        $("#diagnostico").val("@Model.diagnostico").trigger("change");
        $("#tipoEdad").val("@Model.tipo_edad").trigger("change");
        $("#edad").val("@Model.edad").trigger("change");
        $("#tipoGenero").val("@Model.tipo_genero").trigger("change");
        $("#tipoRecomendacion").val("@Model.tipo_recomendacion").trigger("change");
        $("#observaciones").val("@Model.observaciones").trigger("change");
    }

    function CambioTipoFiltrado(value) {
        if (value == 1) {
            document.getElementById("divEdad").style.display = "block";
            document.getElementById("divGenero").style.display = "none";

            $("#divGenero").find("input, select").each(function () {
                if ($(this).is("input")) {
                    $(this).val("");
                } else if ($(this).is("select")) {
                    $(this).prop("selectedIndex", 0);
                }
            });
        }
        else if (value == 2) {
            document.getElementById("divEdad").style.display = "none";
            document.getElementById("divGenero").style.display = "block";

            $("#divEdad").find("input, select").each(function () {
                if ($(this).is("input")) {
                    $(this).val("");
                } else if ($(this).is("select")) {
                    $(this).prop("selectedIndex", 0);
                }
            });
        }
        else {
            document.getElementById("divEdad").style.display = "none";
            document.getElementById("divGenero").style.display = "none";

            $("#divGenero").find("input, select").each(function () {
                if ($(this).is("input")) {
                    $(this).val("");
                } else if ($(this).is("select")) {
                    $(this).prop("selectedIndex", 0);
                }
            });

            $("#divEdad").find("input, select").each(function () {
                if ($(this).is("input")) {
                    $(this).val("");
                } else if ($(this).is("select")) {
                    $(this).prop("selectedIndex", 0);
                }
            });
        }
    }

    function CambioTipoCodificacion(value) {
        if (value == 1) {
            document.getElementById("divCUPS").style.display = "block";
            document.getElementById("divDiagnostico").style.display = "none";

            $("#divDiagnostico").find("input, select").each(function () {
                if ($(this).is("input")) {
                    $(this).val("");
                } else if ($(this).is("select")) {
                    $(this).prop("selectedIndex", 0);
                }
            });
        }
        else {
            document.getElementById("divDiagnostico").style.display = "block";
            document.getElementById("divCUPS").style.display = "none";

            $("#divCUPS").find("input, select").each(function () {
                if ($(this).is("input")) {
                    $(this).val("");
                } else if ($(this).is("select")) {
                    $(this).prop("selectedIndex", 0);
                }
            });
        }
    }

    function GuardarRecomendacion() {

        var validar = $("#formReco").validate();
        if (validar.form()) {
            var formData = new FormData($("#formReco")[0]);
            formData.append("idRecomendacion", $("#idRecomendacion").val());
            formData.append("tipoFiltrado", $("#tipoFiltrado").val());
            formData.append("tipoCodificacion", $("#tipoCodificacion").val());
            formData.append("cups", $("#cups").val());
            formData.append("diagnostico", $("#diagnostico").val());
            formData.append("tipoEdad", $("#tipoEdad").val());
            formData.append("edad", $("#edad").val());
            formData.append("tipoGenero", $("#tipoGenero").val());
            formData.append("tipoRecomendacion", $("#tipoRecomendacion").val());
            formData.append("observaciones", $("#observaciones").val());

            LoadingShow();
            $.ajax({
                url: '@Url.Action("GuardarRecomendaciones", "FIS_RIPS")',
                data: formData,
                method: "POST",
                processData: false,
                contentType: false,

                success: function (data) {

                    LoadingHide();

                    if (data.rta == 1) {
                        mostrarModal("success", "Éxito", data.mensaje);
                    }
                    else {
                        mostrarModal("danger", "Error", data.mensaje);
                    }

                    if (data.rta == 1) {
                        setTimeout(function () {
                            location.reload();
                        }, 3000); // 10000 milisegundos = 10 segundos
                    }
                },
                error: function (xhr, status, error) {
                    LoadingHide();
                }
            });

        }
    }

    function mostrarModal(tipo, titulo, mensaje) {

        var fondo = tipo == "danger" ? "negativo" : "positivo";
        var modalHtml = `
        <div class="modal fade" id="responseModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-${tipo} ${fondo} text-white">
                        <h5 class="modal-title" id="modalLabel">${titulo}</h5>
                    </div>
                    <div class="modal-body text-left" style="max-height: 600px; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word;">
                        ${mensaje}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="button_Asalud_Rechazar" data-dismiss="modal">CERRAR</button>
                    </div>
                </div>
            </div>
        </div>`;

        // Eliminar cualquier modal anterior y agregar la nueva al body
        $("#responseModal").remove();
        $("body").append(modalHtml);

        // Mostrar la modal
        $("#responseModal").modal('show');
    }
</script>
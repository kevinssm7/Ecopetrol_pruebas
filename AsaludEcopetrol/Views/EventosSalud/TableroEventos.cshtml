        var confirmar = confirm("¿Seguro(a) de editar este registro?");
        if (confirmar == true) {
            location.href = "@Url.Action("CargueEventos", "EventosSalud")?idEvento=" + idEvento + "&idConcurrencia=" + idConcurrencia + "&idPlan=" + idPlan;
        }
    }

    function CargarUnis(a) {
        debugger

        if (a != "") {
            $("#unis").empty();
            $.ajax({
                url: "@Url.Action("ObtenerUnis")",
                type: "post",
                data: { idregional: a },
                success: function (data) {
                    $("#unis").empty();
                    $("#unis").html(data);
                    $("#unis").val("").trigger("change");
                }
            })
        }
    }


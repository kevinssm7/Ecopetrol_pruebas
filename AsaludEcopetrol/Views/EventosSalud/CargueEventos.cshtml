@model ECOPETROL_COMMON.ENTIDADES.eventos_salud_registros
@{
    ViewBag.Title = "EVENTOS EN SALUD";
    Layout = "~/Views/Shared/_LayoutECOPETROL.cshtml";
    string msg = ViewBag.msg;
    int rta = ViewBag.rta;
}
<br />

<div class="container">
    <form id="formEventos" name="formEventos" action="CargueEventos" method="post" enctype="multipart/form-data">
        <div class="panel panel-default">
            <div class="panel-heading text-center">
                <strong class="text-primary_asalud">INGRESO EVENTOS EN SALUD</strong>
            </div>
            @if (rta > 0)
            {
                <div class="form-group">
                    @if (rta == 1)
                    {
                        <div class="alert alert-success">
                            <strong>Éxito!</strong> @msg
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <strong>Error!</strong> @msg
                        </div>
                    }
                </div>
                <br />
            }
        </div>

        <div class="panel panel-default" id="divBasicos">
            <div class="panel-heading">
                <strong class="text-primary_asalud">DATOS BÁSICOS DEL REPORTE</strong>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-3">
                        <input type="hidden" value="@ViewBag.idConcurrencia" name="idConcurrencia" id="idConcurrencia" />
                        <input type="hidden" value="@ViewBag.idEvolucion" name="idEvolucion" id="idEvolucion" />
                        <input type="hidden" value="@ViewBag.idEvento" name="id_evento" id="id_evento" />
                        <input type="hidden" value="@ViewBag.idPlan" name="id_planMejora" id="id_planMejora" />
                        <label class="text-secondary_asalud">Año</label>
                        <input type="text" maxlength="199" id="Año" name="Año" onchange="ValidarMeses(this.value)" class="year form-control solo-numero" required />
                    </div>

                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Mes</label>
                        <select id="IdMes" name="IdMes" class="form-control select2" value="" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_meses_del_año item in ViewBag.meses)
                            {
                                <option value="@item.id_mes">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Fecha de reporte</label>
                        <input type="text" id="FechaReporte" name="FechaReporte" value="" class="form-control datepickerr" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Fecha de ocurrencia del evento</label>
                        <input type="text" id="FechaOcurrenciaEvento" name="FechaOcurrenciaEvento" value="" class="form-control datepickerr" required />
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Regional que reporte</label>
                        <select id="RegionalReporta" name="RegionalReporta" class="form-control select2" onchange="seleccionarLocalidad(this.value)" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.Ref_regional item in ViewBag.regional)
                            {
                                <option value="@item.id_ref_regional">@item.nombre_regional</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Localidad de servicios de salud</label>
                        <select id="LocalidadServiciosSalud" name="LocalidadServiciosSalud" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <br />


        <div class="panel panel-default" id="divReportante">
            <div class="panel-heading">
                <strong class="text-primary_asalud">INFORMACIÓN DEL REPORTANTE</strong>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Nombre del reportante</label>
                        <input type="text" maxlength="199" id="NombreReportante" name="NombreReportante" value="" class="form-control" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Identificación del reportante</label>
                        <input type="text" maxlength="199" id="IdentificacionReportante" name="IdentificacionReportante" value="" class="form-control solo-numero" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Nombre del prestador donde ocurrió el evento</label>
                        <input type="text" maxlength="199" id="NombrePrestadorEvento" name="NombrePrestadorEvento" value="" class="form-control" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Código SAP del prestador (si aplica)</label>
                        <input type="text" maxlength="199" id="CodigoSAPPrestador" name="CodigoSAPPrestador" value="" class="form-control" required />
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Nombre del municipio</label>
                        <input type="text" maxlength="199" id="NombreMunicipio" name="NombreMunicipio" value="" class="form-control" required />
                    </div>

                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Código municipal</label>
                        <input type="text" maxlength="199" id="CodigoMunicipal" name="CodigoMunicipal" value="" class="form-control solo-numero" required />
                    </div>
                </div>
            </div>
        </div>
        <br />


        <div class="panel panel-default" id="divBeneficiario">
            <div class="panel-heading">
                <strong class="text-primary_asalud">DATOS DEL PACIENTE (BENEFICIARIO)</strong>
            </div>
            <div class="panel-body">

                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Regional del beneficiario</label>
                        <select id="RegionalBeneficiario" name="RegionalBeneficiario" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.Ref_regional item in ViewBag.regional)
                            {
                                <option value="@item.id_ref_regional">@item.nombre_regional</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Tipo identificación</label>
                        <select id="TipoIdentificacion" name="TipoIdentificacion" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.Ref_tipo_documental item in ViewBag.tipoDocumento)
                            {
                                <option value="@item.id_ref_tipo_documental">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Número de identificación</label>
                        <input type="text" maxlength="199" id="NumeroIdentificacion" name="NumeroIdentificacion" value="" class="form-control solo-numero" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Nombre completo</label>
                        <input type="text" maxlength="199" id="NombreCompleto" name="NombreCompleto" value="" class="form-control" required />
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Edad</label>
                        <input type="text" maxlength="3" id="Edad" name="Edad" value="" class="form-control solo-numero" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Fuente del reporte</label>
                        <select id="FuenteReporte" name="FuenteReporte" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_fuenteReporte item in ViewBag.fuente)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <br />


        <div class="panel panel-default" id="divEventosSalud">
            <div class="panel-heading">
                <strong class="text-primary_asalud">DATOS DEL EVENTO EN SALUD</strong>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Ámbito de ocurrencia del evento</label>
                        <select id="AmbitoOcurrenciaEvento" name="AmbitoOcurrenciaEvento" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_ambitoOcurrencia item in ViewBag.ambito)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Clasificación del evento</label>
                        <select id="ClasificacionEvento" name="ClasificacionEvento" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_clasificacionEvento item in ViewBag.clasificacion)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Categoría del evento</label>
                        <select id="CategoriaEvento" name="CategoriaEvento" class="form-control select2" onchange="ObtenerSubCategoria(this.value)" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_categoriaEvento item in ViewBag.categoria)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Subcategoría del evento</label>
                        <select id="SubcategoriaEvento" name="SubcategoriaEvento" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-3" id="divNegativo">
                        <label class="text-secondary_asalud">Resultado negativo de la medicación</label>
                        <select id="ResultadoNegativoMedicacion" name="ResultadoNegativoMedicacion" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Confirmación del evento adverso</label>
                        <select id="ConfirmacionEventoAdverso" name="ConfirmacionEventoAdverso" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            <option value="1">Prevenible</option>
                            <option value="0">No prevenible</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Severidad del desenlace</label>
                        <select id="SeveridadDesenlace" name="SeveridadDesenlace" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_severidadDesenlace item in ViewBag.severidad)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Probabilidad de repetición</label>
                        <select id="ProbabilidadRepeticion" name="ProbabilidadRepeticion" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_ProbabilidadRepeticion item in ViewBag.probabilidad)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12">
                        <label class="text-secondary_asalud">Descripción del evento</label>
                        <textarea type="text" maxlength="1000" id="DescripcionEvento" name="DescripcionEvento" rows="5" value="" class="form-control" required></textarea>
                    </div>
                </div>
            </div>
        </div>
        <br />


        <div class="panel panel-default" id="divGestionAuditoria">
            <div class="panel-heading">
                <strong class="text-primary_asalud">GESTIÓN DE AUDITORÍA</strong>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Concepto de auditoría</label>
                        <select id="ConceptoAuditoria" name="ConceptoAuditoria" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_eventosSalud_conceptoAuditoria item in ViewBag.concepto)
                            {
                                <option value="@item.id_tipo">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">¿Se generó Plan de Mejora al Prestador? (Sí / No)</label>
                        <select id="PlanMejoraGenerado" name="PlanMejoraGenerado" class="form-control select2" required>
                            <option value="">--Seleccione--</option>
                            <option value="1">SI</option>
                            <option value="0">NO</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="text-secondary_asalud">Costo de no calidad</label>
                        <input type="text" maxlength="199" id="CostoNoCalidad" name="CostoNoCalidad" value="" class="form-control solo-numero" required />
                    </div>
                </div>
                <br />
                <div class="row">

                    <div class="col-sm-6">
                        <label class="text-secondary_asalud">Descripción del costo de no calidad</label>
                        <textarea type="text" maxlength="1000" id="DescripcionCostoNoCalidad" name="DescripcionCostoNoCalidad" value="" class="form-control" required></textarea>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-secondary_asalud">Gestión realizada por la regional</label>
                        <textarea type="text" maxlength="1000" id="GestionRegional" name="GestionRegional" value="" class="form-control" required></textarea>
                    </div>
                </div>
            </div>
        </div>
        <br />

        <div class="panel panel-default" id="divGestionAuditoria">
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-12 text-center">
                        <button class="button_Asalud_Guardar" type="button" onclick="ValidarFormulario()">GUARDAR</button>
                    </div>

                    <div class="col-md-2">
                        <a class="btn btn-sm button_Asalud_Guardar botonGuardarParcial" onclick="GuardarParcial();">GUARDADO PARCIAL</a>
                    </div>
                </div>
            </div>
        </div>

    </form>
</div>

<script src="~/Scripts/validate.js"></script>
@*<script src="https://cdn.jsdelivr.net/npm/compromise-plus@5.2.1"></script>*@

<script>

    if (window.history.replaceState) {
        window.history.replaceState(null, null, window.location.href);
    }

    $(document).ready(function () {

        $('.select2').select2({
            width: '100%',
            height: '100%'
        });

        $('.solo-numero').keyup(function () {
            this.value = (this.value + '').replace(/[^0-9]/g, '');
        });

        $(".datepickerr").kendoDatePicker({
            format: "MM/dd/yyyy",
            max: new Date()
        });

        $(".k-input").attr('readonly', true);

        var idEvento = "@ViewBag.idEvento";

        if (idEvento != 0 && idEvento != null && idEvento != NaN && idEvento != "null")
        {
            CargarDatos();
        }

        var anio = $("#anio").val();
        if (anio != null && anio != "") {
            ValidarMeses(anio);
        }
    });

    function CargarDatos() {
        $("#id_evento").val("@Model.id_evento");
        $("#id_cargue").val("@Model.id_cargue");
        $("#id_concurrencia").val("@Model.id_concurrencia");
        $("#id_evolucion_concurrencia").val("@Model.id_evolucion_concurrencia");
        $("#id_planMejora").val("@Model.id_planMejora");
        $("#Año").val("@Model.Año");
        $("#IdMes").val(@Model.IdMes).trigger("change");;
        $("#Mes").val("@Model.Mes");

        debugger

        var fechaReporte = "@Model.FechaReporte";
        var FechaOcurrenciaEvento = "@Model.FechaOcurrenciaEvento";

        if (fechaReporte != "" && fechaReporte != null && fechaReporte != "null") {
            $("#FechaReporte").val(fechaReporte.replace("12:00:00 a. m.", ""));
        }

        if (FechaOcurrenciaEvento != "" && FechaOcurrenciaEvento != null && FechaOcurrenciaEvento != "null") {
            $("#FechaOcurrenciaEvento").val(FechaOcurrenciaEvento.replace("12:00:00 a. m.", ""));
        }

        $("#RegionalReporta").val(@Model.RegionalReporta).trigger("change");
        $("#LocalidadServiciosSalud").val(@Model.LocalidadServiciosSalud).trigger("change");
        $("#NombreReportante").val("@Model.NombreReportante");
        $("#IdentificacionReportante").val("@Model.IdentificacionReportante");
        $("#NombrePrestadorEvento").val("@Model.NombrePrestadorEvento");
        $("#CodigoSAPPrestador").val("@Model.CodigoSAPPrestador");
        $("#NombreMunicipio").val("@Model.NombreMunicipio");
        $("#CodigoMunicipal").val("@Model.CodigoMunicipal");
        $("#RegionalBeneficiario").val(@Model.RegionalBeneficiario).trigger("change");
        $("#TipoIdentificacion").val("@Model.TipoIdentificacion").trigger("change");
        $("#NumeroIdentificacion").val("@Model.NumeroIdentificacion");
        $("#NombreCompleto").val("@Model.NombreCompleto");
        $("#Edad").val("@Model.Edad");
        $("#FuenteReporte").val("@Model.FuenteReporte").trigger("change");
        $("#AmbitoOcurrenciaEvento").val("@Model.AmbitoOcurrenciaEvento").trigger("change");
        $("#DescripcionEvento").val("@Model.DescripcionEvento");
        $("#ClasificacionEvento").val("@Model.ClasificacionEvento").trigger("change");
        $("#CategoriaEvento").val("@Model.CategoriaEvento").trigger("change");
        $("#SubcategoriaEvento").val("@Model.SubcategoriaEvento").trigger("change");
        $("#ResultadoNegativoMedicacion").val("@Model.ResultadoNegativoMedicacion");
        $("#ConfirmacionEventoAdverso").val("@Model.ConfirmacionEventoAdverso").trigger("change");
        $("#SeveridadDesenlace").val("@Model.SeveridadDesenlace").trigger("change");
        $("#ProbabilidadRepeticion").val("@Model.ProbabilidadRepeticion").trigger("change");
        $("#ConceptoAuditoria").val("@Model.ConceptoAuditoria").trigger("change");
        $("#GestionRegional").val("@Model.GestionRegional");
        $("#PlanMejoraGenerado").val("@Model.PlanMejoraGenerado").trigger("change");
        $("#CostoNoCalidad").val("@Model.CostoNoCalidad");
        $("#DescripcionCostoNoCalidad").val("@Model.DescripcionCostoNoCalidad");
    }

    function formatFecha(fechaStr) {
        if (!fechaStr) return "";

        // Intenta crear un objeto Date a partir de la cadena
        let fecha = new Date(fechaStr);

        if (isNaN(fecha)) {
            // Si falla, intenta reemplazar caracteres raros como "a. m." o "p. m."
            fechaStr = fechaStr.replace(" a. m.", "AM").replace(" p. m.", "PM");
            fecha = new Date(fechaStr);
        }

        if (isNaN(fecha)) return ""; // Si sigue fallando, devuelve vacío

        // Formatea a dd/MM/yyyy
        let dia = String(fecha.getDate()).padStart(2, '0');
        let mes = String(fecha.getMonth() + 1).padStart(2, '0'); // Mes empieza en 0
        let anio = fecha.getFullYear();

        return `${dia}/${mes}/${anio}`;
    }


    $("#ClasificacionEvento").change(function () {
        // Mostrar todas las opciones en caso de cualquier cambio
        $("#ConfirmacionEventoAdverso option").show();

        // Obtener el nuevo valor de clasificación
        var clasificacion = $(this).val();

        // Ocultar las opciones según la nueva clasificación
        if (clasificacion == 1) {
            // Si la clasificación es 1, oculta la opción con valor 1
            $("#ConfirmacionEventoAdverso option[value='1']").hide();
        } else if (clasificacion == 3) {
            // Si la clasificación es 3, oculta las opciones con valores 2 y 3
            $("#ConfirmacionEventoAdverso option[value='2']").hide();
            $("#ConfirmacionEventoAdverso option[value='3']").hide();
        }
    });

    function cambiosNegativo(clasificacion) {

        var categoria = $("#CategoriaEvento").val();
        if (categoria != null && categoria != "") {

            buscarNegativos(categoria, clasificacion);
        }
    }

    function buscarNegativos(categoria, clasificacion) {

        debugger

        $("#ResultadoNegativoMedicacion").empty();
        $.ajax({
            url: "@Url.Action("ObtenerNegativos")",
            type: "post",
            data: {
                categoria: categoria,
                clasificacion: clasificacion
            },
            success: function (data) {
                $("#ResultadoNegativoMedicacion").empty();
                $("#ResultadoNegativoMedicacion").html(data);
                $("#ResultadoNegativoMedicacion").val("").trigger("change");

                var id_evento = $("#id_evento").val();
                if (!isNaN(id_evento) && id_evento != 0) {
                    if ("@Model.ResultadoNegativoMedicacion" != null) {
                        $("#ResultadoNegativoMedicacion").val("@Model.ResultadoNegativoMedicacion").trigger("change");
                    }
                }
            }
        })

        if (clasificacion == 1 || clasificacion == 3) {
            if (categoria == 3 || categoria == 4) {
                $("#divNegativo").css("display", "block");
            } else {
                $("#divNegativo").css("display", "none");
            }
        }
        else {
            $("#divNegativo").css("display", "none");
        }
    }

    function ObtenerSubCategoria(categoria) {

        if (categoria != "") {

            $("#SubcategoriaEvento").empty();

            $.ajax({
                url: "@Url.Action("ObtenerSubCategoria")",
                type: "post",
                data: { categoria: categoria },
                success: function (data) {
                    $("#SubcategoriaEvento").empty();
                    $("#SubcategoriaEvento").html(data);
                    $("#SubcategoriaEvento").val("").trigger("change");

                    var id_evento = $("#id_evento").val();
                    if (!isNaN(id_evento) && id_evento != 0) {
                        if ("@Model.SubcategoriaEvento" != null) {
                            $("#SubcategoriaEvento").val("@Model.SubcategoriaEvento").trigger("change");
                        }
                    }
                }
            })
        }

        var clasificacion = $("#ClasificacionEvento").val();
        if (clasificacion != null && clasificacion != "") {
            buscarNegativos(categoria, clasificacion);
        }
    }

    function ValidarMeses(anioSeleccionado) {

        var mesSelect = document.getElementById("IdMes");
        var añoActual = new Date().getFullYear();

        // Limpiar selección actual
        mesSelect.options.length = 1;

        // Obtener meses disponibles
        var meses = [];

        if (anioSeleccionado == añoActual) {
            var mesActual = new Date().getMonth() + 1; // Se suma 1 porque los meses en JavaScript van de 0 a 11
            for (var i = 1; i <= mesActual; i++) {
                meses.push({ id: i, descripcion: ObtenerNombreMes(i) });
            }
        } else {
            meses = @Html.Raw(Json.Encode(ViewBag.meses)); // Convertir a array de JavaScript
        }

        meses.forEach(function (mes) {
            var option = document.createElement("option");
            var id = mes.id;
            option.value = id;
            option.text = mes.descripcion;
            document.getElementById("IdMes").add(option);
        });
    }

    function ObtenerNombreMes(numeroMes) {
        var meses = ["ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO", "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"];
        return meses[numeroMes - 1];
    }

    function ValidarFormulario() {
        var validator = $("#formEventos").validate();
        if (validator.form()) {
            $("#formEventos").submit();
        }
    }

    function seleccionarLocalidad(regional) {

        $.ajax({
            url: "@Url.Action("ObtenerUnis", "RadicacionElectonica")",
            type: "post",
            data: {
                regional: regional
            },
            success: function (data) {
                $("#LocalidadServiciosSalud").empty();
                $("#LocalidadServiciosSalud").val("").trigger("change");
                $("#LocalidadServiciosSalud").html(data);
                var id_evento = $("#id_evento").val();
                if (!isNaN(id_evento) && id_evento != 0) {
                    if ("@Model.LocalidadServiciosSalud" != null) {
                        $("#LocalidadServiciosSalud").val("@Model.LocalidadServiciosSalud").trigger("change");
                    }
                }
            }
        })
    }

    function GuardarParcial() {
        // Tomamos los datos del formulario
        var formData = $("#formEventos").serializeArray();
        var data = {};

        // Convertimos a objeto JSON
        $.map(formData, function (n, i) {
            data[n['name']] = n['value'];
        });

        LoadingShow();

        $.ajax({
            url: "@Url.Action("CargueEventosParcial", "EventosSalud")",
            type: 'POST',
            data: JSON.stringify({ Model: data }), // Ojo: debe ir como { Model: data }
            contentType: 'application/json; charset=utf-8',
            success: function (response) {

                LoadingHide();
                $("#id_evento").val(response.idEvento);
                $("#id_planMejora").val(response.idPlan);

            },
            error: function (xhr, status, error) {
                console.error(error);
                alert("Hubo un error al enviar el evento");
            }
        });
    }

</script>



@{
    ViewBag.Title = "TABLERO CONTROL VALIDACIONES RIPS FIS";
    Layout = "~/Views/Shared/_LayoutECOPETROL.cshtml";

}


<div class="container">
    <div class="panel panel-default">


        
        <div id="mensajeRespuesta">

        </div>


        <div class="panel-heading">
            <strong class="text-primary_asalud">DATOS</strong>
        </div>
        <br />
        <form >
            <div class="panel-body">

                <table id="tabla" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Id Validacion</th>
                            <th>Código Validación</th>
                            <th>Descripción Regla</th>
                            <th>Mensaje - Log Error</th>
                            <th>Archivo Validación</th>
                            <th>Estado</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{int i = 0;}

                        @if (ViewBag.conteo > 0)
                        {
                            foreach (ECOPETROL_COMMON.ENTIDADES.ref_validaciones_Ripsfis item in ViewBag.listado)
                            {
                                i++;
                        <tr>
                            <td class="text-center">@item.id_validacion</td>
                            <td class="text-center">@item.cod_validacion</td>
                            <td class="text-center">@item.regla</td>
                            <td class="text-center">@item.mensaje</td>
                            <td class="text-center">@item.archivo</td>
                            @if (item.estado == 1)
                            {
                                <td class="text-center">ACTIVA</td>
                                <td>
                                    <a class="btn btn-sm button_Asalud_Rechazar" onclick="actualizarValidacion(@item.id_validacion, 0);">
                                        INACTIVAR
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td class="text-center">INACTIVA</td>
                                <td>
                                    <a class="btn btn-sm button_Asalud_Aceptar" onclick="actualizarValidacion(@item.id_validacion, 1);">
                                        ACTIVAR
                                    </a>
                                </td>
                            }


                        </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" style="width:100%; text-align:center">SIN DATOS</td>
                            </tr>
                        }

                    </tbody>
                </table>


            </div>
        </form>
    </div>
</div>
<script src="~/Scripts/validate.js"></script>
<script>


    $(document).ready(function () {
        $('.select2').select2({
            width: '100%'
        });

        $(".datepickerr").kendoDatePicker({
            format: "MM/dd/yyyy",
        });

        $(".k-input").attr('readonly', true);

    });

    $('.table').DataTable({
        "sSearch": "Buscar:",
        "searching": true,
        "iDisplayLength": 15,
        "lengthChange": false,
        "info": false,
        responsive: true,
        language: {
            "decimal": "",
            "emptyTable": "No hay información",
            "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
            "infoEmpty": "Mostrando 0 to 0 of 0 Entradas",
            "infoFiltered": "(Filtrado de _MAX_ total entradas)",
            "infoPostFix": "",
            "thousands": ",",
            "lengthMenu": "Mostrar _MENU_ Entradas",
            "loadingRecords": "Cargando...",
            "processing": "Procesando...",
            "search": "Buscar:",
            "zeroRecords": "Sin resultados encontrados",
            "paginate": {
                "first": "Primero",
                "last": "Ultimo",
                "next": "Siguiente",
                "previous": "Anterior"
            }
        },
    });


    function actualizarValidacion(idValidacion, estado) {

        var confirmar = confirm("¿Esta seguro de modificar el estado de la validación?");

        if (confirmar == true) {

            $.ajax({
            url: '@Url.Action("ActualizarValidacionRips", "RipsFis")', // ajusta el nombre del controlador
            type: "POST",
            data: { idValidacion: idValidacion, estado: estado },
            success: function (response) {


                location.reload();

                $("#mensajeRespuesta").empty();


                if (response.idrta === 1) {
                    $("#mensajeRespuesta").html(
                        `<div class="alert alert-success" role="alert">${response.mensaje}</div>`
                    );
                } else {
                    $("#mensajeRespuesta").html(
                        `<div class="alert alert-danger" role="alert">${response.mensaje}</div>`
                    );
                }

            },
            error: function () {
                $("#mensajeRespuesta").html(
                    `<div class="alert alert-danger" role="alert">Error al modificar el registro.</div>`
                );
            }
            });

        }



    }



</script>




@{
    ViewBag.Title = "TABLERO ERRORES ENVIO HES";
    Layout = "~/Views/Shared/_LayoutECOPETROL.cshtml";
    int i = 0;
}

<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-primary_asalud">Filtrado</strong>
    </div>
    <div class="panel-body">
        <form id="formBusqueda" method="post" action="TableroErroresEnvioHES">
            <div class="row">
                <div class="col-md-3">
                    <label class="text-secondary_asalud">Fecha inicio</label>
                    <input type="text" id="fechaInicio" name="fechaInicio" class="form-control datepickerr" style="width:100%;"  required/>
                </div>
                <div class="col-md-3">
                    <label class="text-secondary_asalud">Fecha fin</label>
                    <input type="text" id="fechaFin" name="fechaFin" class="form-control datepickerr" style="width:100%;" required/>
                </div>

                <br />
                <div class="col-md-2">
                    <a class="btn button_Asalud_Aceptar" onclick="BuscaDatos()">BUSCAR</a>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-primary_asalud">Listado de errores</strong>
    </div>
    <div class="col-md-12">

        @if (ViewBag.conteo > 0)
        {
            <div class="col-md-2">
                <a class="btn  btnDescargarALL" onclick="DescargarResultados();" title="Descargar todos los datos">DESCARGAR</a>
            </div>
        }
    </div>
    <br />

    <div class="panel-body">
        <div class="img-responsive">
            <table id="TablaErrores" class="table table-striped table-bordered table-condensed table-responsive">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id registro</th>
                        <th>Lote</th>
                        <th>Id error</th>
                        <th>Id VIM</th>
                        <th>Número factura</th>
                        <th>Posición</th>
                        <th>Id mensaje</th>
                        <th>Num mensaje</th>
                        <th>Mensaje</th>
                        <th>fecha digita</th>
                    </tr>
                </thead>
                <tbody>

                    @if (ViewBag.conteo > 0)
                    {
                        foreach (ECOPETROL_COMMON.ENTIDADES.management_fis_API_TableroErroresBAPIHESResult item in ViewBag.listado)
                        {
                            i++;
                            <tr>
                                <td>@i</td>
                                <td>@item.id_registro</td>
                                <td>@item.id_lote</td>
                                <td>@item.id_error</td>
                                <td>@item.id_vim</td>
                                <td>@item.num_factura</td>
                                <td>@item.posicion</td>
                                <td>@item.id_mensaje</td>
                                <td>@item.num_mensaje</td>
                                <td>@item.mensaje</td>
                                <td>@item.fecha_digita.Value.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="24" style="text-align:center">SIN REGISTROS</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<script src="httpS://code.jquery.com/ui/1.11.3/jquery-ui.js"></script>
<script src="~/Scripts/validate.js"></script>

<script>

    $(document).ready(function () {
        $(".datepickerr").kendoDatePicker({
            format: "MM/dd/yyyy"
        });

        $(".k-input").attr('readonly', true);

        MostrarTabla();

        $('.select2').select2({
            width: '100%',
            height: '100%'
        });

    });

    function MostrarTabla() {
        var conteo = '@ViewBag.conteo';
        if (conteo > 0) {

            $('#TablaErrores').DataTable().destroy();
            $('#TablaErrores').DataTable({
                "searching": true,
                "aLengthMenu": [[50, 100, 250, 500, 1000, 5000, -1], [50, 100, 250, 500, 1000, 5000, "Todos"]],
                "iDisplayLength": 5000,
                "lengthchange": true,
                "info": false,
                "responsive": true,
                "zeroRecords": "No se encontraron resultados",
                responsive: true,
                language: {
                    sLengthMenu: "Ver _MENU_ registros",
                    processing: "Procesando...",
                    search: "Buscar:",
                    lengthmenu: "Mostrar menu registros",
                    info: "Mostrando registros del start al end de un total de total registros",
                    infoempty: "Mostrando registros del 0 al 0 de un total de 0 registros",
                    infofiltered: "(Filtrado de un total de max registros)",
                    loadingrecords: "Cargando...",
                    zerorecords: "No se encontraron resultados",
                    emptytable: "Ningún dato disponible en esta tabla",
                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Ultimo",
                    },
                }
            });
        }
    }

    function DescargarResultados() {
        var url = "@Url.Action("DescargarReporteHESErrores", "RadicacionElectonica")";
        popupWindow = window.open(url, '', 'height=200,width=500,left=20,top=400,resizable=yes,scrollbars=yes,toolbar=yes,menubar=no,location=no,directories=no, status=yes')
    }


    function BuscaDatos() {
        var valida = $("#formBusqueda").validate();
        if (valida.form()) {
            $("#formBusqueda").submit();
        }
    }

</script>




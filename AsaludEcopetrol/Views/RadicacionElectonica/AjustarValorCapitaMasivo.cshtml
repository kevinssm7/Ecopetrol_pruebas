
<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-primary_asalud">AJUSTAR VALORES</strong>
    </div>
    <div class="panel-body">
        <form id="formValores">
            <div class="row">
                <div class="col-md-6">
                    <label class="text-secondary_asalud">Valor</label>
                    <input type="text" class="form-control solo-numero" id="valorNuevo" name="valorNuevo" maxlength="100" required />
                </div>
            </div>
            <br />

            <div class="row text-center">
                <a class="btn button_Asalud_Guardar" onclick="ValidarDatos();">GUARDAR</a>
            </div>
        </form>
    </div>
</div>

<script>


    $(document).ready(function () {
        $('.solo-numero').keyup(function () {
            this.value = (this.value + '').replace(/[^0-9]/g, '');
        });

    });


    function ValidarDatos() {

        var validar = $("#formValores").validate();
        if (validar.form()) {
            var formData = new FormData($("#formCie10")[0]);
            formData.append("seleccionados", "@ViewBag.seleccionados");
            formData.append("idFactura", "@ViewBag.idFactura");
            formData.append("valorNuevo", $("#valorNuevo").val());

            LoadingShow();

            $.ajax({
                url: "@Url.Action("GuardarNuevoValorCapita")",
                data: formData,
                type: "post",
                processData: false,
                contentType: false,

                success: function (data) {

                    alert(data.mensaje);
                    LoadingHide();

                    if (data.rta == 1) {
                        $("#ModalValorCapita").modal("hide");
                        desenglosasIdsGestionMasivos("@ViewBag.seleccionados");
                    }
                }
            });
        }
    }
</script>
@{
    ViewBag.Title = "TABLERO COMPRIMIDOS MEDICAMENTOS DISPENSANCIÓN";
    Layout = "~/Views/Shared/_LayoutECOPETROL.cshtml";

}

<script type="text/javascript" src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js"></script>
<link rel="Stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" />

<br />


<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-primary_asalud">TABLERO MEDICAMENTOS DISPENSANCIÓN</strong>
    </div>
    <div class="panel-body">

        <form id="formulario" method="post" enctype="multipart/form-data" action="TableroComprimidosMedDispen">
            <div class="row">
                <div class="col-sm-2">
                    <label class="text-secondary_asalud">Periodo del reporte</label>
                    <select class="form-control select2" id="mes" name="mes">
                        <option value="">- MES- </option>
                        @foreach (ECOPETROL_COMMON.ENTIDADES.ref_meses_del_año item in ViewBag.meses)
                        {
                            <option value="@item.id_mes">@item.descripcion</option>
                        }
                    </select>
                </div>
                <div class="col-sm-2">
                    <label class="text-secondary_asalud">Año del reporte</label>
                    <select name="año" id="año" class="form-control select2" required>
                        <option value="">-AÑO-</option>
                        @{
                            int añoActual = DateTime.Now.Year;
                            for (int año = añoActual; año >= 2015; año--)
                            {
                                <option value="@año">@año</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-sm-4">
                    <label class="control-label text-secondary_asalud">Prestador</label>
                    <select class="form-control select2" name="prestador" id="prestador">
                        <option value="">- Seleccionar -</option>

                        @foreach (var item in ViewBag.lstPrestador)
                        {
                            <option value="@item.id_ref_prestadores">@item.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-sm-4">
                    <label class="control-label text-secondary_asalud">Regional</label>
                    <select class="form-control select2" name="regional" id="regional">
                        <option value="">- Seleccionar -</option>
                        @foreach (ECOPETROL_COMMON.ENTIDADES.Ref_regional item in ViewBag.regionales)
                        {
                            <option value="@item.id_ref_regional">@item.nombre_regional</option>
                        }
                    </select>
                </div>
            </div>
            <br />

            <div class="row">
                <div class="col-sm-12 form-group text-right">
                    <button class="btn button_Asalud_Guardar" type="button" onclick="ValidarFormulario()"><i class="glyphicon glyphicon-search"></i>&nbsp; Buscar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <div class="table-responsive">
            <table class="tablaDatos table-bordered table-condensed table-striped" style="width: 98%; font-size: 12px;">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Nombre archivo</th>
                        <th>Prestador</th>
                        <th>Regional</th>
                        <th>Mes del reporte </th>
                        <th>Año del reporte </th>
                        <th>Fecha cargue</th>
                        <th>Usuario cargue</th>
                        <th>Descargar</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 0;}
                    @if (ViewBag.conteo != 0 && ViewBag.conteo != null)
                    {
                        foreach (ECOPETROL_COMMON.ENTIDADES.management_medicamentos_listadoComprimidosResult item in ViewBag.listaMed)
                        {
                            i++;
                            <tr>
                                <td class="text-center">@i</td>
                                <td>@item.nombre_Archivo</td>
                                <td>@item.nombrePrestador</td>
                                <td>@item.nombre_regional</td>
                                <td>@item.descripcionMes</td>
                                <td>@item.año</td>
                                <td>@item.fecha_digita</td>
                                <td>@item.nombreDigita</td>
                                <td>
                                    <a style="text-decoration-color:#5168a8" class="alink" onclick="AbrirArchivoZip(@item.id_archivo)"> Ver Archivo </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" style="font-size: 14px; text-align:center"> SIN DATOS</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@*</div>*@

<script src="~/Scripts/validate.js"></script>
<script>

    $(document).ready(function () {

        $('.select2').select2({
            width: '100%'
        });

        $(".datepickerr").kendoDatePicker({
            format: "MM/dd/yyyy",
        });
        $(".k-input").attr('readonly', true);

        mostrarTabla();
    });

    function mostrarTabla() {
        var conteo = @ViewBag.conteo;
        if (conteo > 0) {
            $('.tablaDatos').DataTable().destroy();

            $('.tablaDatos').DataTable({
                "searching": true,
                "idisplaylength": 15,
                "lengthchange": false,
                "info": false,
                responsive: true,
                language: {
                    processing: "procesando...",
                    search: "Buscar:",
                    lengthmenu: "mostrar menu registros",
                    info: "mostrando registros del start al end de un total de total registros",
                    infoempty: "mostrando registros del 0 al 0 de un total de 0 registros",
                    infofiltered: "(filtrado de un total de max registros)",
                    infopostfix: "",
                    loadingrecords: "cargando...",
                    zerorecords: "no se encontraron resultados",
                    emptytable: "ningún dato disponible en esta tabla",
                    paginate: {
                        first: "primero",
                        previous: "anterior",
                        next: "siguiente",
                        last: "último",
                    },
                }
            });
        }
    }

    function ValidarFormulario() {
        var validator = $("#formulario").validate();
        if (validator.form()) {
            LoadingShow();
            $("#formulario").submit();
        }
    }

    function AbrirArchivoZip(archivo) {
        var url = "@Url.Action("VerSoporteMedicamentos", "MedicamentosCalidad")?archivo=" + archivo;
        popupWindow = window.open(url, '', 'height=500,width=700,left=50,top=50,resizable=yes,scrollbars=yes,toolbar=yes,menubar=no,location=no,directories=no, status=yes')
    }
</script>



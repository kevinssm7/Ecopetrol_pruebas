@model AsaludEcopetrol.Models.Censo.AlertasEpidemiologicas


<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-secondary_asalud">Gestión</strong>
    </div>
    <div class="panel-body">

        <form id="formModal">

            <div class="row">
                <div class="col-md-12">
                    <input type="hidden" readonly id="id_alertas_generadas_concurrencia" name="id_alertas_generadas_concurrencia" class="form-control" value="@Model.id_alertas_generadas_concurrencia" />
                    
                </div>
            </div>
            <br />

            <div class="row" id="divEdicion">
                <div class="col-md-6">
                    <label class="text-secondary_asalud" for="descripcion">Descripción alerta</label>
                    <input id="descripcion" name="descripcion" class="form-control" value="@Model.descripcion" required/>
                </div>


                <div class="col-md-6">
                    <label class="text-secondary_asalud" for="tipo_alerta">Tipo de alerta</label>
                    <select id="tipo_alerta" name="tipo_alerta" class="form-control" required>
                        <option value="Alerta informativa" @(Model.tipo_alerta == "Alerta informativa" ? "selected" : "")>Informativa</option>
                        <option value="Alerta para gestión inmediata" @(Model.tipo_alerta == "Alerta para gestión inmediata" ? "selected" : "")>Gestión Inmediata</option>
                        <option value="Alerta que requiere alguna gestión" @(Model.tipo_alerta == "Alerta que requiere alguna gestión" ? "selected" : "")>Requiere Alguna Gestión</option>

                    </select>
                </div>

            </div>

            <br />
            <br />

            <div class="row" id="ffg">
                <div class="col-md-6">
                    <label class="text-secondary_asalud" for="grupo_diagnostico">Grupo diagnistico</label>
                    <input id="grupo_diagnostico" name="grupo_diagnostico" class="form-control" value="@Model.grupo_diagnostico" required/>
                </div>


                <div class="col-md-6">
                    <label class="text-secondary_asalud" for="tipo_evento">Tipo de evento</label>
                    <select id="tipo_evento" name="tipo_evento" class="form-control" required>
                        <option value="Catastrófico" @(Model.Tipo_Evento == "Catastrófico" ? "selected" : "")>Catastrófico</option>
                        <option value="Centinela" @(Model.Tipo_Evento == "Centinela" ? "selected" : "")>Centinela</option>
                        <option value="Eventos en salud" @(Model.Tipo_Evento == "Eventos en salud" ? "selected" : "")>Eventos en salud</option>
                        <option value="Salud Publica" @(Model.Tipo_Evento == "Salud Publica" ? "selected" : "")>Salud Publica</option>
                        <option value="Trazadora" @(Model.Tipo_Evento == "Trazadora" ? "selected" : "")>Trazadora</option>
                    </select>
                </div>


            </div>

            <br />
            <br />


            <div class="row" id="divEdicion">
                <div class="col-md-6">
                    <label class="text-secondary_asalud" for="nombre_alerta">Nombre de alerta general</label>
                    <input id="Nombre_De_Alerta" name="Nombre_De_Alerta" class="form-control" value="@Model.Nombre_De_Alerta" required/>
                </div>


                <div class="col-md-6">
                    <label class="text-secondary_asalud" for="descripcion_alerta">Descripcion de alerta general</label>
                    <input id="descripcion_alerta" name="descripcion_alerta" class="form-control" value="@Model.Descripcion_Alerta" required/>
                </div>


            </div>



            <br />

            <div class="row text-center">
                <a class="btn button_Asalud_Guardar" onclick="validarFormModal()">GUARDAR</a>
            </div>
        </form>
    </div>
</div>





<script>

    $(document).ready(function () {

        $('.char-count').each(function () {
            var maxLength = $(this).attr('maxlength'); // Obtiene el maxlength de cada textarea
            var $counter = $(this).next('.charCount'); // Obtiene el elemento <p> siguiente para mostrar el conteo

            // Inicializa el contador con el máximo de caracteres
            $counter.text('Te quedan ' + maxLength + ' caracteres.');

            // Actualiza el contador al escribir en el textarea
            $(this).on('input', function () {
                var textLength = $(this).val().length;
                var charsRemaining = maxLength - textLength;
                $counter.text('Te quedan ' + charsRemaining + ' caracteres.');
            });
        });

    });



    function validarFormModal() {

        var validacion = $("#formModal").validate();
        if (validacion.form()) {
            GuardarModal();
        }
    }

    function GuardarModal() {

        var formData = new FormData($("#formModal")[0]);
        formData.append("id_alertas_generadas_concurrencia", $("#id_alertas_generadas_concurrencia").val());
        formData.append("descripcion", $("#descripcion").val());
        formData.append("tipo_alerta", $("#tipo_alerta").val());
        formData.append("grupo_diagnostico", $("#grupo_diagnostico").val());
        formData.append("tipo_evento", $("#tipo_evento").val());
        formData.append("Nombre_De_Alerta", $("#Nombre_De_Alerta").val());
        formData.append("descripcion_alerta", $("#descripcion_alerta").val());
       
        LoadingShow();

        $.ajax({
            url: "@Url.Action("GuardarEdicionEpidemiologica")",
            method: "post",
            type: "post",
            data: formData,
            processData: false,
            contentType: false,

            success: function (data) {
                alert(data.mensaje);
                LoadingHide();
                if (data.rta == 1) {
                    location.reload();
                }
                else {
                    alert("Error: " + data.mensaje);
                }
            }
        });
    }

</script>

<style>
    .charCount {
        font-size: 10px;
    }
</style>

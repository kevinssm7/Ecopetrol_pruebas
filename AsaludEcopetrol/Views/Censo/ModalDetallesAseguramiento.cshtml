@model ECOPETROL_COMMON.ENTIDADES.cargue_censo_ah_registros_detalle

<div class="panel panel-default">
    <div class="panel-heading">
        <p class="title text-center">
            <h4>
                <input type="hidden" value="@ViewBag.idLote" name="idLote" id="idLote" />
                <input type="hidden" value="@ViewBag.idDetalle" name="idDetalle" id="idDetalle" />
                <input type="hidden" value="@Model.id_detalle" name="idDet" id="idDet" />
                <input type="hidden" value="@ViewBag.numero_documento" name="documento" id="documento" />

                <a class="text-primary_asalud">Ingreso de datos hospitalización: @ViewBag.nombre</a>
            </h4>
        </p>
    </div>

    <div class="panel-body">
        <div class="table-responsive">
            <table class="tableDetalle table-condensed table-bordered" style="width:97%;">
                <thead>
                    <tr>
                        <th class="text-center">Documento</th>
                        <th class="text-center">Regional</th>
                        <th class="text-center">UNIS</th>
                        <th class="text-center">Municipio</th>
                        <th class="text-center">Nombre IPS</th>
                        <th class="text-center">Fecha ingreso</th>
                        <th class="text-center">Fecha egreso</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ECOPETROL_COMMON.ENTIDADES.management_censo_aseguramientoTableroControl_idResult item in ViewBag.listado)
                    {
                        <tr>
                            <td>@item.documentoCompleto</td>
                            <td>@item.regional</td>
                            <td>@item.unis</td>
                            <td>@item.municipio</td>
                            <td>@item.ips</td>
                            @if (item.fecha_ingreso != null)
                            {
                                <td>@item.fecha_ingreso.Value.ToString("dd/MM/yyyy")</td>
                            }
                            else
                            {
                                <td>@item.fecha_ingreso</td>
                            }

                            @if (item.fecha_egreso != null)
                            {
                                <td>@item.fecha_egreso.Value.ToString("dd/MM/yyyy")</td>
                            }
                            else
                            {
                                <td>@item.fecha_egreso</td>
                            }
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    <div class="panel-body">
        <form id="formDet">

            <div class="row">
                <div class="col-md-6">
                    <label class="text-secondary_asalud">¿Es hospitalización?</label>
                    <select id="hospitalizacion" name="hospitalizacion" class="form-control" onchange="ValidacionHospi(this.value, 1)" required>
                        <option value="">-Seleccione-</option>
                        <option value="1">SI</option>
                        <option value="0">NO</option>
                    </select>
                </div>
            </div>
            <br />



            <div class="row" id="divHabitacion" style="display:none">
                <div class="col-md-6">
                    <label class="text-secondary_asalud">¿Corte facturación?</label>
                    <select id="corte_facturacion" name="corte_facturacion" class="form-control" onchange="validacionHabi(this.value)" required>
                        <option value="">-Seleccione-</option>
                        <option value="1">SI</option>
                        <option value="0">NO</option>
                    </select>
                </div>
            </div>
            <br />


            <div class="row" id="divCampoObsNoHospi" style="display:none">
                <div class="col-md-12">
                    <label class="text-secondary_asalud">Observación</label>
                    <textarea id="hospitalizacion_no_observacion" name="hospitalizacion_no_observacion" class="form-control" style="width:100%;" maxlength="4999" cols="4" rows="6" required></textarea>
                </div>
            </div>

            <div id="divCamposCompletos" style="display:none">
                <div class="row">
                    <div class="col-md-6">

                        <label class="text-secondary_asalud">Tipo de habitación</label>
                        <select id="tipoHabitacion" name="tipoHabitacion" class="form-control" required>
                            <option value="">-Seleccione-</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.Ref_tipo_habitacion item in ViewBag.tipoHabitacion)
                            {
                                <option value="@item.id_ref_tipo_habitacion">@item.descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Línea de pago</label>
                        <select id="lineaPago" name="lineaPago" class="form-control" required>
                            <option value="">-Seleccione-</option>
                            @foreach (ECOPETROL_COMMON.ENTIDADES.ref_censo_linea_pago item in ViewBag.lineasPago)
                            {
                                <option value="@item.id_linea">@item.descripcion</option>
                            }
                        </select>
                    </div>
                </div>
                <br />

                <div class="row">
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">CIE10</label>
                        <input type="text" id="cie10" name="cie10" maxlength="300" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">Descripción CIE10</label>
                        <input type="text" id="cie10Des" name="cie10Des" maxlength="300" class="form-control" required />
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-4">
                        <label class="text-secondary_asalud">¿Caso inferior 72 horas?</label>
                        <select id="caso_inferior_72horas" name="caso_inferior_72horas" class="form-control" onchange="MostrarNotas(this.value)" required>
                            <option value="">-Seleccione-</option>
                            <option value="1">SI</option>
                            <option value="0">NO</option>
                        </select>
                    </div>
                </div>
                <br />

                <div class="row" id="divNotas" style="display:none;">
                    <div class="col-md-12">
                        <label class="text-secondary_asalud">Notas de auditoría</label>
                        <textarea id="notas" name="notas" rows="5" cols="5" class="form-control" maxlength="500" required></textarea>
                    </div>

                </div>
                <br />


                <div class="row" id="divConcurrencia" style="display:none">
                    <div class="col-md-6">
                        <label class="text-secondary_asalud">¿Está registrado en SAMI concurrencia?</label>
                        <select id="Concurrencia" name="Concurrencia" class="form-control" onchange="validacionConcu(this.value)" required>
                            <option value="">-Seleccione-</option>
                            <option value="1">SI</option>
                            <option value="0">NO</option>
                        </select>
                    </div>

                    <div class="col-md-6" id="divIdConcurrencia" style="display:none">
                        <label class="text-secondary_asalud">ID de concurrencia</label>
                        <input class="form-control solo-numeros" type="text" id="IdConcurrencia" name="IdConcurrencia" maxlength="10" required />
                    </div>

                </div>
                <br />


            </div>

            <br/>

            <div class="row text-center" id="divGuardar">
                <a class="button_Asalud_Guardar" onclick="validarForm();">Guardar</a>
            </div>

        </form>
    </div>
</div>

<script>

    $(document).ready(function () {
        $('.solo-numeros').keyup(function () {
            this.value = (this.value + '').replace(/[^0-9.]/g, '');
        });
        $('.select2').select2({
            width: '100%',
            height: '100%'
        });

        debugger

        var idDet = "@Model.id_detalle";
        if (idDet != null && idDet != 0) {
            MostrarDatos();
        }
    });

    function MostrarDatos() {

        var tipo = "@ViewBag.tipo";

        if (tipo == 1) {
            ValidacionHospi("@Model.hospitalizacion", 1);
        }



        else if (tipo == 2) {
            $("#hospitalizacion").val("@Model.hospitalizacion").trigger("change").prop("disabled", true);
            $("#corte_facturacion").val("@Model.corte_facturacion").trigger("change").prop("disabled", true);
            $("#caso_inferior_72horas").val("@Model.caso_inferior_72horas").trigger("change").prop("disabled", true);
            $("#Concurrencia").val("@Model.tiene_concurrencia").trigger("change").prop("disabled", true);

            $("#tipoHabitacion").val('@Model.tipo_habitacion').trigger("change");
            $("#lineaPago").val('@Model.linea_pago').trigger("change");
            $("#cie10").val('@Model.cie10').trigger("change");
            $("#cie10Des").val('@Model.descripcion_cie10').trigger("change");
            $("#notas").val('@Model.nota_auditoria').trigger("change");
            $("#IdConcurrencia").val('@Model.id_concurrencia').trigger("change");

            $("#tipoHabitacion").prop("disabled", true);
            $("#lineaPago").prop("disabled", true);
            $("#cie10").prop("disabled", true);
            $("#cie10Des").prop("disabled", true);
            $("#notas").prop("disabled", true);
            $("#IdConcurrencia").prop("disabled", true);

            document.getElementById("divGuardar").style.display = "none";

            ValidacionHospi("@Model.hospitalizacion", 2);

        }



        else {

            $("#hospitalizacion").val(1).trigger("change").prop("disabled", true);
            $("#corte_facturacion").val(1).trigger("change").prop("disabled", true);
            $("#caso_inferior_72horas").val(0).trigger("change").prop("disabled", true);

            ValidacionHospi("@Model.hospitalizacion", 3);


        }
    }

    function MostrarCie10() {

        $("#cie10").autocomplete({
            source: function (request, response) {
                debugger
                if (request.term.length > 0) {
                    $.ajax({
                        url: "/Censo/BuscarCie10",
                        type: "POST",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            if (data.length > 0 && data != null) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.label,
                                        value: item.id
                                    };
                                }));
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error(xhr.responseText);
                        }
                    });
                }
            },
            select: function (event, ui) {

                var detalle = ui.item.label;
                var descomposicion = detalle.split('-');
                var descripcion = descomposicion[1];
                $("#cie10Des").val(descripcion);
            }
        });


        $("#cie10Des").autocomplete({
            source: function (request, response) {
                if (request.term.length > 0) {
                    $.ajax({
                        url: "/Censo/BuscarCie10",
                        type: "POST",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            if (data.length > 0 && data != null) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.label,
                                        value: item.des
                                    };
                                }));
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error(xhr.responseText);
                        }
                    });
                }
            },
            select: function (event, ui) {

                debugger

                var detalle = ui.item.label;
                var descomposicion = detalle.split('-');
                var descripcion = descomposicion[0];
                $("#cie10").val(descripcion);
            }
        });

    }



    function MostrarNotas(valor) {

        $("#notas").val("");
        $("#notas").text("");

        if (valor == 0) {
            document.getElementById("divNotas").style.display = "block";
        }
        else {
            document.getElementById("divNotas").style.display = "none";
        }
    }


    function validarForm() {
        var validar = $("#formDet").validate();
        if (validar.form()) {
            EnviarDatos();
        }
    }

    function EnviarDatos() {

        var formData = new FormData($("#formDet")[0]);

        formData.append("idLote", $("#idLote").val());

        formData.append("idDetalle", $("#idDetalle").val());

        formData.append("documento", $("#documento").val());

        formData.append("id_det", $("#idDet").val());
        formData.append("hospitalizacion", $("#hospitalizacion").val());
        formData.append("corte_facturacion", $("#corte_facturacion").val());
        formData.append("tipoHabitacion", $("#tipoHabitacion").val());
        formData.append("lineaPago", $("#lineaPago").val());
        formData.append("cie10", $("#cie10").val());
        formData.append("cie10Des", $("#cie10Des").val());
        formData.append("caso_inferior_72horas", $("#caso_inferior_72horas").val());
        formData.append("notas", $("#notas").val());
        formData.append("tiene_concurrencia", $("#Concurrencia").val());
        formData.append("id_concurrencia", $("#IdConcurrencia").val());

        LoadingShow();

        $.ajax({
            url: '@Url.Action("GuardarDetallesAseguramiento", "Censo")',
            type: "POST",
            data: formData,
            method: "POST",
            processData: false,
            contentType: false,

            success: function (response) {
                LoadingHide();
                alert(response.mensaje);
                location.reload();
                $('#ModalDetallado').modal("hide");

            },
            error: function (xhr, status, error) {
                LoadingHide();
            }
        });
    }

    function EliminarGestion(idDetalle) {
        var confirmar = confirm("¿Seguro(a) de eliminar este registro?");
        if (confirmar == true) {
            LoadingShow();

            $.ajax({
                url: '@Url.Action("EliminarGestionDetalle", "Censo")',
                type: "POST",
                data: {
                    idDetalle: idDetalle
                },
                method: "POST",
                success: function (response) {
                    LoadingHide();
                    alert(response.mensaje);
                    MostrarDetalle($("#idLote").val(), $("#idDetalle").val());
                },
                error: function (xhr, status, error) {
                    LoadingHide();
                }
            });
        }
    }

    function ValidacionHospi(valor, tipo) {

        if (tipo == 1) {
            if (valor == 1) {
                document.getElementById("divHabitacion").style.display = "block";
                document.getElementById("divCampoObsNoHospi").style.display = "none";
            } else {
                document.getElementById("divHabitacion").style.display = "none";
                document.getElementById("divCamposCompletos").style.display = "none";
                document.getElementById("divCampoObsNoHospi").style.display = "block";

                if (@Model.id_detalle != null && @Model.id_detalle != 0) {
                    $("#hospitalizacion_no_observacion").val("@Model.hospitalizacion_no_observacion").trigger("change").prop("disabled", true);
                }
            }
        }


        else if (tipo == 2) {
            if (valor == 1) {
                document.getElementById("divHabitacion").style.display = "block";
                document.getElementById("divCamposCompletos").style.display = "block";
                document.getElementById("divCampoObsNoHospi").style.display = "none";

            } else {
                document.getElementById("divHabitacion").style.display = "none";
                document.getElementById("divCamposCompletos").style.display = "none";

                document.getElementById("divCampoObsNoHospi").style.display = "block";

                if (@Model.id_detalle != null && @Model.id_detalle != 0) {
                    $("#hospitalizacion_no_observacion").val("@Model.hospitalizacion_no_observacion").trigger("change").prop("disabled", true);
                }
            }
        }
        else {
            document.getElementById("divHabitacion").style.display = "block";
            document.getElementById("divCamposCompletos").style.display = "block";
            document.getElementById("divConcurrencia").style.display = "block";
            document.getElementById("divCampoObsNoHospi").style.display = "none";
            MostrarCie10();
        }
    }

    function validacionConcu(valor) {
        document.getElementById("divIdConcurrencia").style.display = "none";

        if (valor == 1) {
            document.getElementById("divIdConcurrencia").style.display = "block";
            
        } else {
            document.getElementById("divIdConcurrencia").style.display = "none";
        }
    }

    function validacionHabi(valor) {
        document.getElementById("divCampoObsNoHospi").style.display = "none";

        if (valor == 0) {
            document.getElementById("divCamposCompletos").style.display = "block";
            MostrarCie10();
            document.getElementById("divConcurrencia").style.display = "block";
        } else {
            document.getElementById("divCamposCompletos").style.display = "none";
            document.getElementById("divConcurrencia").style.display = "none";
        }
    }


</script>

<style>
    .tableDetalle {
        font-family: "Century Gothic", "Century Gothic", Sans-Serif;
        font-size: 12px;
        margin: 10px;
        width: 100%;
        text-align: left;
        border-collapse: collapse;
    }

        .tableDetalle th {
            font-weight: bold;
            padding: 8px;
            background: #636363;
            border-top: 4px solid #aabcfe;
            border-bottom: 1px solid #fff;
            color: #e8e8e8;
        }

        .tableDetalle td {
            padding: 8px;
            background: #efefef;
            border-bottom: 2px solid #fff;
            color: #636363;
            border-top: 1px solid transparent;
        }

        .tableDetalle tr:hover td {
            background: #bcbcbc;
            color: #1c1c1c;
        }

    .ui-autocomplete {
        z-index: 9999 !important; /* Establece un z-index alto */
        color: #556DA2;
        background-color: #fff;
        width: 50%;
        border: 1px;
        cursor: alias;
    }

    /* Si es necesario, también puedes ajustar el z-index de la modal */
    .modal {
        z-index: 1050; /* Ajusta el z-index de la modal si es necesario */
    }


    .form-control[disabled], .form-control[readonly], fieldset[disabled] .form-control {
        color: #555555;
    }

</style>
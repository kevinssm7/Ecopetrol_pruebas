

<div class="panel panel-default">
    <div class="panel-heading">
        <p class="title text-center">
            <h4>
                <a class="text-primary_asalud" data-toggle="collapse" data-parent="#accordion">ACCIONES DE MEJORA</a>
            </h4>
            <h5>
                <label class="text-secondary_asalud">Id. @ViewBag.idPlan</label>
            </h5>
        </p>
    </div>
    <div class="panel-body">
        <div id="divTabla">
            <div class="table-responsive">
                <table id="tableTareas" class="table table-bordered table-condensed" style="font-size:11px; width:100%;  margin:0px !important">
                    <thead>
                        <tr>
                            <th class="text-center">Id hallazgo</th>
                            <th class="text-center">Id plan</th>
                            <th class="text-center">Categoría</th>
                            <th class="text-center">Foco</th>
                            <th class="text-center">Hallazgo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Gestionar</th>
                        </tr>
                    </thead>
                    <tbody id="tbodytbl2">
                        @if (ViewBag.conteoTareas > 0)
                        {
                            var i = 0;

                            foreach (ECOPETROL_COMMON.ENTIDADES.management_planMejora_tableroControlGestionPrestadores_hallazgosResult item in ViewBag.listadoTareas)
                            {
                                i++;
                                <tr>
                                    <td class="text-center">@item.idHallazgo</td>
                                    <td class="text-center">@item.IdPlan</td>
                                    <td class="text-center">@item.Nomcategoria</td>
                                    <td class="text-center">@item.Nomfoco</td>
                                    <td class="text-center">@item.hallazgo</td>
                                    <td class="text-center">@item.descripcion_estado_gestionPrestador</td>
                                    <td class="text-center">
                                        <a class="btn btn-sm button_Asalud_Aceptar" onclick="GestionarACR(@item.idHallazgo, @item.IdPlan)">Gestionar ACR</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12" style="text-align:center; font-size:15px;">
                                    <label>Sin archivos.</label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <br />
    </div>
</div>

<div class="modal fade" data-keyboard="false" data-backdrop="static" id="myModalGestiones">
    <div class="modal-dialog modal-lg" style="width:90%">
        <div class="modal-content">
            <div class="modal-body">
                <div id="resultadoGes"></div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        MostrarTablaTareas();
    });

    function MostrarTablaTareas() {
        var conteo = "@ViewBag.conteoTareas";
        if (conteo > 0) {

            $('#tableTareas').DataTable().destroy();
            $('#tableTareas').DataTable({
                "sSearch": "Buscar:",
                "searching": true,
                "iDisplayLength": 20,
                "lengthChange": false,
                "info": false,
                responsive: true,
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 to 0 of 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "infoPostFix": "",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                },
            });
        }
    }

    function GestionarACR(idHallazgo, idPlan) {

        var laURLDeLaVista = '@Url.Action("GestionarACR")?idHallazgo=' + idHallazgo + '&idPlan=' + idPlan;
        $.ajax({
            cache: false,
            async: true,
            type: "GET",
            url: laURLDeLaVista,
            data: {},
            success: function (response) {
                $('#resultadoGes').html('');
                $('#resultadoGes').html(response);
                $("#myModalGestiones").modal("show");
            }
        });
    }



</script>

<style>
    #myModalGestiones {
        z-index: 1000;
        position: absolute;
        margin-bottom: -600px;
        margin-top: -120px;
    }
</style>
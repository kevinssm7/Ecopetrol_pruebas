    function VerHallazgos(idPlan) {
        var laURLDeLaVista = '@Url.Action("MostrarTareasPlanMejoraGestionPrestador")?idPlan=' + idPlan;
        $.ajax({
            cache: false,
            async: true,
            type: "GET",
            url: laURLDeLaVista,
            data: {},
            success: function (response) {
                $('#resultado').html('');
                $('#resultado').html(response);
                $("#myModalTareas").modal("show");
            }
        });
    }

    function VerDatosExcel() {
        var URL2 = "@Url.Action("DescargarReportePM", "PlanesMejora")";
        window.open(URL2, '', 'width =450,height =140,left =10,top =550,toolbar =yes');
    }

    function CargarSoporteAdmin(idPlan) {

        $.ajax({
            cache: false,
            async: true,
            type: "GET",
            url: "@Url.Action("ModalCargueSoportesAdmin", "PlanMejora")",
            data: {
                idPlan: idPlan
            },
            success: function (response) {
                $('#rslAdmin').html('');
                $('#rslAdmin').html(response);
                $("#ModalCargueAdmin").modal("show");
            }
        })
    }

    function BuscarDatos() {
        $("#formEnvioDatos").submit();
    }

    function exportarExcelInd(id) {
        location.href = "@Url.Action("ExcelExportarIndividual", "Verificacion")?id=" + id;
    }


    function CerrarModalHallazgos() {
        location.reload();
    }

</script>



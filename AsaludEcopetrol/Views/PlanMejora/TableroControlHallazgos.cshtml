}

<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-primary-Asalud">FILTROS</strong>
    </div>
    <div class="panel-body">
        <form id="formEnvioDatos" method="post" action="TableroPlanesMejora">

            <div class="row">
                @*<div class="col-md-2">
                    <label class="text-secondary_asalud">Id visita dispensación</label>
                    <input type="text" class="form-control solo-numero" id="idEva" name="idEva" maxlength="10" />
                </div>*@

                <div class="col-md-3">
                    <label class="text-secondary_asalud">Fecha inicial dispensación</label>
                    <input type="text" class="form-control" id="fechaIni" name="fechaIni" style="width:100%;" />
                </div>

                <div class="col-md-3">
                    <label class="text-secondary_asalud">Fecha final dispensación</label>
                    <input type="text" class="form-control" id="fechaFin" name="fechaFin" style="width:100%;" />
                </div>
                <div class="col-md-3">
                    <label class="text-secondary_asalud">Nit dispensación</label>
                    <input type="text" class="form-control solo-numero" id="nit" name="nit" maxlength="15" />
                </div>
                <br />

                <div class="col-md-1 text-left">
                    <a class="btn btn-sm button_Asalud_Aceptar" onclick="BuscarDatos();"><i class="glyphicon glyphicon-search"></i>&nbsp; Buscar</a>
                </div>
            </div>
            <br />
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <strong class="text-primary-Asalud">ESTADOS</strong>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-8">
                <ul class="nav nav-pills" style="font-size: 12px">
                    <li class="active" id="li1"><a class="collapse1" href="#tab0" data-toggle="tab">Sin gestión @ViewBag.conteoSin</a></li>
                    <li id="li2"><a href="#tab1" class="collapse2" data-toggle="tab">Pendientes @ViewBag.conteoPendiente</a></li>
                    <li id="li3"><a href="#tab2" class="collapse3" data-toggle="tab">Aprobados @ViewBag.conteoAprobado</a></li>
                    <li id="li4"><a href="#tab3" class="collapse4" data-toggle="tab">Negados @ViewBag.conteoNegado</a></li>
                </ul>
            </div>
            <div class="col-md-4 text-right">
                <a class="btn button_Asalud_descargas" onclick="VerDatosExcel();"><i class="glyphicon glyphicon-download"></i>&nbsp; Exportar</a>
            </div>
        </div>
    </div>
</div>
<div class="panel panel-default">

            width: '100%'
        });

        $("#fechaIni").kendoDatePicker();
        $("#fechaFin").kendoDatePicker();

        $("#fechaIni").prop('readonly', true);
        $("#fechaFin").prop('readonly', true);

        $('.select2').select2({
            width: '100%'
        });

        $('.solo-numero').keyup(function () {
            this.value = (this.value + '').replace(/[^0-9]/g, '');
        });
    })


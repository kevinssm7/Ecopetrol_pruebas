            <div class="tab-pane active" id="tab0">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="tableroSin table table-bordered table-condensed" style="font-size:10px; width:98%;">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Id visitas</th>
                                        <th>Id dispensación</th>
                                        <th>Estado</th>
                                        <th>Regional</th>
                                        <th>Unis</th>
                                        <th>Localidad</th>
                                        <th>Prestador</th>
                                        <th>Fecha creación</th>
                                        <th>Proceso</th>
                                        <th>Auditor</th>
                                        <th>Fecha seguimiento</th>
                                        <th>Fecha estimada cierre</th>
                                        <th>Acciones de mejora</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.conteoSin > 0)
                                    {
                                        foreach (ECOPETROL_COMMON.ENTIDADES.management_planMejora_tableroControlGestionPrestadoresResult item in ViewBag.listadoSinGestion)
                                        {
                                            var estilo = "";
                                            var fechaMinimaPlazo = new DateTime();
                                            var fechaMaximaPlazo = new DateTime();

                                            if (item.fechaminimaplazo != null)
                                            {
                                                fechaMinimaPlazo = Convert.ToDateTime(item.fechaminimaplazo.Value.ToString("yyyy/MM/dd"));
                                            }
                                            else
                                            {
                                                fechaMinimaPlazo = new DateTime(2000, 01, 01);
                                            }

                                            if (item.fechaminimaplazo != null)
                                            {
                                                fechaMaximaPlazo = Convert.ToDateTime(item.fechamaximaplazo.Value.ToString("yyyy/MM/dd"));
                                            }
                                            else
                                            {
                                                fechaMaximaPlazo = new DateTime(2000, 01, 01);
                                            }

                                            {
                                                if (item.conteomeses > 0)
                                                {
                                                    estilo = "TrAzul";
                                                }
                                                else
                                                {
                                                    estilo = "TrNaranja";

                                                }
                                            }

                                            <tr class="@estilo">

                                                <td>@item.id_plan_de_mejora</td>
                                                <td>@item.id_visitas</td>
                                                <td>@item.id_visitas_dispen</td>
                                                <td>@item.estadoplan</td>
                                                <td>@item.nombre_regional</td>
                                                <td>@item.nom_unis</td>
                                                <td>@item.nombrelocalidad</td>
                                                <td>@item.nom_prestador</td>
                                                <td>@item.fecha_creacion.Value.ToString("dd/MM/yyyy")</td>
                                                <td>@item.nom_proceso</td>
                                                <td>@item.nombre</td>

                                                <td>
                                                    @(item.fechaminimaplazo != null ? item.fechaminimaplazo.Value.ToString("dd/MM/yyyy") : "")
                                                </td>

                                                <td>
                                                    @(item.fechamaximaplazo != null ? item.fechamaximaplazo.Value.ToString("dd/MM/yyyy") : "")
                                                </td>

                                                <td class="text-center">
                                                    <a class="btn btn-sm button_Asalud_Aceptar" onclick="VerHallazgos(@item.id_plan_de_mejora)">Gestionar hallazgo</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14" style="width:100%; text-align:center">SIN DATOS</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

